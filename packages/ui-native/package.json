{
  "name": "@prs/ui-native",
  "version": "0.0.0",
  "description": "Shared UI components for React Native (React Native CLI projects).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "./src/index.ts",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prs/prs-ui.git",
    "directory": "packages/ui-native"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@prs/ui-shared": "workspace:*",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@prs/config": "workspace:*",
    "@prs/ui-shared": "workspace:*",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "react-native": "^0.76.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "prs",
    "ui",
    "native",
    "react-native",
    "components",
    "component-library"
  ],
  "engines": {
    "node": ">=18"
  }
}
