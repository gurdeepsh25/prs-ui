{
  "name": "@prs/config",
  "version": "0.0.0",
  "private": true,
  "description": "Internal shared development configuration (TypeScript base config, tsup factory) for @prs/ui packages. Not published.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./tsup-config.cjs",
  "types": "./tsup-config.d.ts",
  "exports": {
    "./tsconfig.package.json": "./tsconfig.package.json",
    "./tsup-config": {
      "types": "./tsup-config.d.ts",
      "import": "./tsup-config.mjs",
      "require": "./tsup-config.cjs",
      "default": "./tsup-config.mjs"
    }
  },
  "files": [
    "tsconfig.package.json",
    "tsup-config.mjs",
    "tsup-config.cjs",
    "tsup-config.d.ts"
  ],
  "scripts": {
    "build": "tsup tsup-config.ts --format esm,cjs --dts --clean",
    "clean": "rm -rf dist tsup-config.mjs tsup-config.cjs tsup-config.d.ts tsup-config.js tsup-config.js.map node_modules/.cache",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
